{
  "info": {
    "name": "Workbench - Plataforma (todos os microsserviços)",
    "description": "Collection unificada dos 4 microsserviços da plataforma Workbench (Fase 4). Cada pasta tem sua própria baseUrl, pois no cluster cada serviço é exposto em um host/porta diferente (via Gateway ou port-forward). Variáveis: customerUrl, osUrl, billingUrl, executionUrl e token (JWT HS256 com role ADMIN/TECHNICIAN). A pasta 'Fluxo Saga (E2E)' executa o caminho feliz ponta a ponta na ordem correta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "customerUrl", "value": "http://localhost:8081"},
    {"key": "osUrl", "value": "http://localhost:8080"},
    {"key": "billingUrl", "value": "http://localhost:8082"},
    {"key": "executionUrl", "value": "http://localhost:8083"},
    {"key": "token", "value": ""},
    {"key": "clientId", "value": "1"},
    {"key": "productId", "value": "PROD-1"},
    {"key": "orderId", "value": ""},
    {"key": "cpfCnpj", "value": "52998224725"},
    {"key": "placa", "value": "ABC-1234"}
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
  },
  "item": [
    {
      "name": "Customer Service",
      "item": [
        {"name": "Criar cliente", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{customerUrl}}/api/clients", "host": ["{{customerUrl}}"], "path": ["api", "clients"]}, "body": {"mode": "raw", "raw": "{\n  \"name\": \"Maria Oliveira\",\n  \"document\": \"52998224725\",\n  \"email\": \"maria@example.com\",\n  \"phone\": \"11999990000\"\n}"}}},
        {"name": "Criar veículo", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{customerUrl}}/api/vehicles", "host": ["{{customerUrl}}"], "path": ["api", "vehicles"]}, "body": {"mode": "raw", "raw": "{\n  \"clientId\": {{clientId}},\n  \"plate\": \"ABC-1234\",\n  \"brand\": \"Volkswagen\",\n  \"model\": \"Gol\",\n  \"year\": 2018,\n  \"color\": \"Prata\",\n  \"type\": \"CARRO\"\n}"}}},
        {"name": "Listar clientes", "request": {"method": "GET", "url": {"raw": "{{customerUrl}}/api/clients", "host": ["{{customerUrl}}"], "path": ["api", "clients"]}}},
        {"name": "Buscar cliente por documento", "request": {"method": "GET", "url": {"raw": "{{customerUrl}}/api/clients/document/{{cpfCnpj}}", "host": ["{{customerUrl}}"], "path": ["api", "clients", "document", "{{cpfCnpj}}"]}}}
      ]
    },
    {
      "name": "Execution Service",
      "item": [
        {"name": "Criar produto", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{executionUrl}}/api/products", "host": ["{{executionUrl}}"], "path": ["api", "products"]}, "body": {"mode": "raw", "raw": "{\n  \"name\": \"Óleo 5W30\",\n  \"sku\": \"OLEO-5W30\",\n  \"type\": \"PART\",\n  \"unit\": \"UN\",\n  \"category\": \"Lubrificantes\",\n  \"brand\": \"Mobil\",\n  \"costPrice\": 25.00,\n  \"salePrice\": 45.00,\n  \"warrantyMonths\": 6,\n  \"fractionalAllowed\": false,\n  \"packageSize\": 1\n}"}}},
        {"name": "Criar estoque", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{executionUrl}}/api/stocks", "host": ["{{executionUrl}}"], "path": ["api", "stocks"]}, "body": {"mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 100,\n  \"minimumQuantity\": 10\n}"}}},
        {"name": "Listar estoques", "request": {"method": "GET", "url": {"raw": "{{executionUrl}}/api/stocks", "host": ["{{executionUrl}}"], "path": ["api", "stocks"]}}},
        {"name": "Listar reservas da OS", "request": {"method": "GET", "url": {"raw": "{{executionUrl}}/api/stocks/reservations/service-order/{{orderId}}", "host": ["{{executionUrl}}"], "path": ["api", "stocks", "reservations", "service-order", "{{orderId}}"]}}}
      ]
    },
    {
      "name": "OS Service",
      "item": [
        {"name": "Listar tipos de serviço", "request": {"method": "GET", "url": {"raw": "{{osUrl}}/service-types", "host": ["{{osUrl}}"], "path": ["service-types"]}}},
        {"name": "Criar OS", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{osUrl}}/order", "host": ["{{osUrl}}"], "path": ["order"]}, "body": {"mode": "raw", "raw": "{\n  \"cpfCnpj\": \"{{cpfCnpj}}\",\n  \"placaVeiculo\": \"{{placa}}\",\n  \"serviceTypes\": [\"TROCA_OLEO\"]\n}"}}},
        {"name": "Listar OS", "request": {"method": "GET", "url": {"raw": "{{osUrl}}/order", "host": ["{{osUrl}}"], "path": ["order"]}}},
        {"name": "Buscar OS por ID", "request": {"method": "GET", "url": {"raw": "{{osUrl}}/order/id/{{orderId}}", "host": ["{{osUrl}}"], "path": ["order", "id", "{{orderId}}"]}}}
      ]
    },
    {
      "name": "Billing Service",
      "item": [
        {"name": "Buscar orçamento da OS", "request": {"method": "GET", "url": {"raw": "{{billingUrl}}/api/budgets/service-order/{{orderId}}", "host": ["{{billingUrl}}"], "path": ["api", "budgets", "service-order", "{{orderId}}"]}}},
        {"name": "Criar cobrança", "request": {"method": "POST", "url": {"raw": "{{billingUrl}}/api/payments/service-order/{{orderId}}", "host": ["{{billingUrl}}"], "path": ["api", "payments", "service-order", "{{orderId}}"]}}},
        {"name": "Histórico de pagamento", "request": {"method": "GET", "url": {"raw": "{{billingUrl}}/api/payments/service-order/{{orderId}}/history", "host": ["{{billingUrl}}"], "path": ["api", "payments", "service-order", "{{orderId}}", "history"]}}}
      ]
    },
    {
      "name": "Fluxo Saga (E2E - caminho feliz)",
      "description": "Execute na ordem: cria cliente/veículo/produto/estoque, cria a OS, registra diagnóstico (dispara a Saga), aprova o orçamento e confirma o pagamento via webhook. O orderId é capturado automaticamente na criação da OS.",
      "item": [
        {"name": "1. Criar cliente", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{customerUrl}}/api/clients", "host": ["{{customerUrl}}"], "path": ["api", "clients"]}, "body": {"mode": "raw", "raw": "{\n  \"name\": \"Maria Oliveira\",\n  \"document\": \"52998224725\",\n  \"email\": \"maria@example.com\",\n  \"phone\": \"11999990000\"\n}"}}},
        {"name": "2. Criar veículo", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{customerUrl}}/api/vehicles", "host": ["{{customerUrl}}"], "path": ["api", "vehicles"]}, "body": {"mode": "raw", "raw": "{\n  \"clientId\": {{clientId}},\n  \"plate\": \"ABC-1234\",\n  \"brand\": \"Volkswagen\",\n  \"model\": \"Gol\",\n  \"year\": 2018,\n  \"color\": \"Prata\",\n  \"type\": \"CARRO\"\n}"}}},
        {"name": "3. Criar OS", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('orderId', pm.response.json().id); }"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{osUrl}}/order", "host": ["{{osUrl}}"], "path": ["order"]}, "body": {"mode": "raw", "raw": "{\n  \"cpfCnpj\": \"{{cpfCnpj}}\",\n  \"placaVeiculo\": \"{{placa}}\",\n  \"serviceTypes\": [\"TROCA_OLEO\"]\n}"}}},
        {"name": "4. Registrar diagnóstico (dispara a Saga)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{osUrl}}/order/{{orderId}}/diagnosis", "host": ["{{osUrl}}"], "path": ["order", "{{orderId}}", "diagnosis"]}, "body": {"mode": "raw", "raw": "{\n  \"parts\": [ { \"productId\": \"{{productId}}\", \"quantity\": 2 } ],\n  \"labor\": [ { \"serviceName\": \"TROCA_OLEO\", \"laborCost\": 80.00 } ]\n}"}}},
        {"name": "5. Consultar orçamento gerado", "request": {"method": "GET", "url": {"raw": "{{billingUrl}}/api/budgets/service-order/{{orderId}}", "host": ["{{billingUrl}}"], "path": ["api", "budgets", "service-order", "{{orderId}}"]}}},
        {"name": "6. Aprovar orçamento", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{osUrl}}/order/{{orderId}}/decision", "host": ["{{osUrl}}"], "path": ["order", "{{orderId}}", "decision"]}, "body": {"mode": "raw", "raw": "{\n  \"decision\": \"APPROVED\"\n}"}}},
        {"name": "7. Webhook de pagamento aprovado", "request": {"method": "POST", "auth": {"type": "noauth"}, "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{billingUrl}}/api/payments/webhook", "host": ["{{billingUrl}}"], "path": ["api", "payments", "webhook"]}, "body": {"mode": "raw", "raw": "{\n  \"serviceOrderId\": \"{{orderId}}\",\n  \"status\": \"APPROVED\"\n}"}}},
        {"name": "8. Conferir OS final (PAGO/ENTREGUE)", "request": {"method": "GET", "url": {"raw": "{{osUrl}}/order/id/{{orderId}}", "host": ["{{osUrl}}"], "path": ["order", "id", "{{orderId}}"]}}}
      ]
    }
  ]
}
